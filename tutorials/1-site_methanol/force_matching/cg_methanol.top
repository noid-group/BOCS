; We have to work a little harder writing the topology for our CG simulation
; Than we did for our atomistic simulation because there are no top level
; files to reference

;defaults is usually a top level file directive. 
[ defaults ] ; Sets the default NB function type, combination rule, whether 14 interactions not listed should be autogenerated, and how to change the energy parameter in 14 interactions 
; nbfunc        comb-rule       gen-pairs       fudgeLJ fudgeQQ
  1             1               no               1.0     1.0
; For 1-site models, it doesn't matter 


;atomtypes is usually a top level file directive. 
[ atomtypes ]
;name       mass        charge   ptype       c6           c12
 MEO        32.042    0.000    A           0            1	; Note that here we set c6 and c12 to 0 and 1, this allows us to use a tabulated interaction the .mdp file 

[ moleculetype ] ; same directives as we saw in the atomistic top/itp files
; name  nrexcl
MEO     3

[ atoms ]
;   nr    type   resnr  residu    atom    cgnr  charge
    1     MEO    1      MEO         MEO    1     0.00

[ system ]
MEO

[ molecules ]
MEO     968
